#!/usr/bin/env bash
# Compare this knowledge repo's tooling against the upstream template and prepare updates.
# Uses three-way merge to preserve local adaptations while pulling in upstream changes.
#
# Usage: check-upstream [--apply]
#   Without --apply: prints a summary table of what changed.
#   With --apply: performs three-way merges, writes results to the repo,
#                 and updates the base commit for next time.
#
# State: tooling/.upstream-base records the upstream commit SHA the local copy was synced to.
# On first run (no base file), it uses the initial commit of the local repo to find the
# closest upstream commit, or treats the current upstream as the base.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
base_state_file="$repo/tooling/.upstream-base"
upstream_repo="videlov/claude-knowledge-template"
upstream_url="https://github.com/$upstream_repo"

# Trackable paths: template scaffolding that should receive upstream updates.
# User data (findings/, projects/) is excluded except for template-shipped findings.
TRACKABLE_PREFIXES=(
  "tooling/"
  "README.md"
  ".gitignore"
  "findings/claude-code-token-usage.md"
)
# Always skip these even if they match a prefix (generated or user-filled).
# check-upstream skips itself to avoid self-modification during sync;
# update it manually or via a separate PR when the upstream skill changes.
SKIP_PATHS=(
  "INDEX.md"
  "tooling/.upstream-base"
  "tooling/skills/check-upstream/"
)

apply=false
if [ "${1:-}" = "--apply" ]; then apply=true; fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# --- Download upstream tarball (no auth needed, public repo) ---
echo "Fetching upstream from $upstream_url ..."
curl -fsSL "$upstream_url/archive/refs/heads/main.tar.gz" | tar -xz -C "$tmp"
upstream_dir="$tmp/claude-knowledge-template-main"
if [ ! -d "$upstream_dir" ]; then
  echo "error: failed to download upstream tarball" >&2
  exit 1
fi

# Get the upstream HEAD commit SHA (no auth needed, no rate limit, no python3).
upstream_sha=$(git ls-remote "https://github.com/$upstream_repo.git" refs/heads/main | cut -f1)
if [ -z "$upstream_sha" ]; then upstream_sha="unknown"; fi

# --- Determine the base version ---
# If we have a stored base, fetch that tarball too for three-way merge.
# Otherwise, bootstrap by finding the newest upstream commit older than the
# repo's first commit (for "Use this template" copies), then fall back to
# treating current upstream as the base.
base_dir=""
base_sha=""
if [ -f "$base_state_file" ]; then
  base_sha=$(cat "$base_state_file" | tr -d '[:space:]')
  echo "Stored base: ${base_sha:0:12}"
  if curl -fsSL "$upstream_url/archive/$base_sha.tar.gz" | tar -xz -C "$tmp" 2>/dev/null; then
    # The extracted directory name uses the full SHA
    base_dir=$(find "$tmp" -maxdepth 1 -type d -name "claude-knowledge-template-*" ! -name "claude-knowledge-template-main" | head -1)
  fi
  if [ -z "$base_dir" ] || [ ! -d "$base_dir" ]; then
    echo "warning: could not fetch base commit $base_sha; falling back to local-as-base" >&2
    base_dir=""
    base_sha=""
  fi
else
  # First run: bootstrap the base.
  # For a "Use this template" copy, find the newest upstream commit before the repo's first commit.
  first_commit_date=$(git -C "$repo" log --reverse --format='%aI' | head -1)
  if [ -n "$first_commit_date" ]; then
    bootstrap_sha=$(curl -fsSL "https://api.github.com/repos/$upstream_repo/commits?until=$first_commit_date&per_page=1" \
      | python3 -c 'import json,sys; c=json.load(sys.stdin); print(c[0]["sha"] if c else "")' 2>/dev/null || true)
    if [ -n "$bootstrap_sha" ]; then
      echo "Bootstrapping base from upstream commit ${bootstrap_sha:0:12} (before repo creation)"
      if curl -fsSL "$upstream_url/archive/$bootstrap_sha.tar.gz" | tar -xz -C "$tmp" 2>/dev/null; then
        base_dir=$(find "$tmp" -maxdepth 1 -type d -name "claude-knowledge-template-*" ! -name "claude-knowledge-template-main" | head -1)
        if [ -n "$base_dir" ] && [ -d "$base_dir" ]; then
          base_sha="$bootstrap_sha"
        fi
      fi
    fi
  fi
  if [ -z "$base_sha" ]; then
    echo "note: could not bootstrap base; files will be reported as 'changed (no base)'"
  fi
fi

is_trackable() {
  local path="$1"
  for skip in "${SKIP_PATHS[@]}"; do
    case "$path" in "$skip"*) return 1 ;; esac
  done
  for prefix in "${TRACKABLE_PREFIXES[@]}"; do
    case "$path" in "$prefix"*) return 0 ;; esac
  done
  return 1
}

# --- Collect all trackable paths from upstream, local, and base ---
declare -A all_paths
while IFS= read -r -d '' f; do
  rel="${f#"$upstream_dir"/}"
  if is_trackable "$rel"; then all_paths["$rel"]=1; fi
done < <(find "$upstream_dir" -type f -print0)

while IFS= read -r -d '' f; do
  rel="${f#"$repo"/}"
  if is_trackable "$rel"; then all_paths["$rel"]=1; fi
done < <(find "$repo" -type f -not -path "$repo/.git/*" -print0)

# --- Classify each path ---
declare -A status  # up-to-date, upstream-only, local-only, changed-upstream, changed-local, changed-both, deleted-upstream
declare -A merge_result  # path -> file with merge result (for --apply)
declare -A has_conflicts  # path -> 1 if merge had conflicts

for rel in $(printf '%s\n' "${!all_paths[@]}" | sort); do
  local_file="$repo/$rel"
  upstream_file="$upstream_dir/$rel"
  base_file_path=""
  if [ -n "$base_dir" ]; then base_file_path="$base_dir/$rel"; fi

  has_local=false; if [ -f "$local_file" ]; then has_local=true; fi
  has_upstream=false; if [ -f "$upstream_file" ]; then has_upstream=true; fi
  has_base=false; if [ -n "$base_file_path" ] && [ -f "$base_file_path" ]; then has_base=true; fi

  if $has_upstream && ! $has_local; then
    status["$rel"]="new-upstream"
    if $apply; then
      merge_result["$rel"]="$upstream_file"
    fi

  elif $has_local && ! $has_upstream; then
    # File exists locally but not upstream.
    if $has_base; then
      # It was in base but removed upstream → deleted upstream.
      status["$rel"]="deleted-upstream"
    else
      # Never existed upstream (local addition). Skip — not our concern.
      status["$rel"]="local-only"
    fi

  elif $has_upstream && $has_local; then
    if diff -q "$local_file" "$upstream_file" >/dev/null 2>&1; then
      status["$rel"]="up-to-date"
    elif [ -z "$base_dir" ]; then
      # No base: can't do three-way merge. Just report as changed.
      status["$rel"]="changed-no-base"
      if $apply; then
        merge_result["$rel"]="$upstream_file"
      fi
    else
      # Three-way merge.
      local_changed=true; upstream_changed=true
      if $has_base; then
        if diff -q "$base_file_path" "$local_file" >/dev/null 2>&1; then local_changed=false; fi
        if diff -q "$base_file_path" "$upstream_file" >/dev/null 2>&1; then upstream_changed=false; fi
      else
        # File didn't exist in base: both sides added it independently.
        local_changed=true
        upstream_changed=true
      fi

      if ! $upstream_changed; then
        status["$rel"]="changed-local-only"
      elif ! $local_changed; then
        status["$rel"]="changed-upstream-only"
        if $apply; then
          merge_result["$rel"]="$upstream_file"
        fi
      else
        status["$rel"]="changed-both"
        if $apply; then
          merged="$tmp/merged-$(echo "$rel" | tr '/' '-')"
          base_for_merge="$base_file_path"
          if ! $has_base; then
            base_for_merge="$tmp/empty"
            touch "$base_for_merge"
          fi
          if git merge-file -p "$local_file" "$base_for_merge" "$upstream_file" > "$merged" 2>/dev/null; then
            merge_result["$rel"]="$merged"
          else
            merge_result["$rel"]="$merged"
            has_conflicts["$rel"]=1
          fi
        fi
      fi
    fi
  fi
done

# --- Report ---
echo ""
echo "Upstream: $upstream_repo @ ${upstream_sha:0:12}"
if [ -n "$base_sha" ]; then
  echo "Base:     ${base_sha:0:12}"
else
  echo "Base:     (none — first run)"
fi
echo ""

print_section() {
  local label="$1" filter="$2"
  local found=false
  for rel in $(printf '%s\n' "${!status[@]}" | sort); do
    [ "${status[$rel]}" = "$filter" ] || continue
    $found || { echo "### $label"; found=true; }
    echo "  $rel"
  done
  $found && echo "" || true
}

print_section "Up to date" "up-to-date"
print_section "Changed upstream only (safe to apply)" "changed-upstream-only"
print_section "Changed locally only (no upstream update)" "changed-local-only"
print_section "Changed on both sides (needs review)" "changed-both"
print_section "Changed (no base — manual review needed)" "changed-no-base"
print_section "New upstream (not present locally)" "new-upstream"
print_section "Deleted upstream (present locally)" "deleted-upstream"
print_section "Local only (not in upstream)" "local-only"

# --- Apply ---
if ! $apply; then
  echo "Run with --apply to perform merges and update files."
  echo "Files with both-sides changes will get conflict markers for manual resolution."
  exit 0
fi

echo "=== Applying updates ==="
applied=0
conflicted=0
for rel in $(printf '%s\n' "${!merge_result[@]}" | sort); do
  src="${merge_result[$rel]}"
  dest="$repo/$rel"
  mkdir -p "$(dirname "$dest")"

  if [ "${has_conflicts[$rel]:-}" = "1" ]; then
    cp "$src" "$dest"
    echo "CONFLICT: $rel (conflict markers inserted, resolve manually)"
    conflicted=$((conflicted + 1))
  else
    cp "$src" "$dest"
    # Preserve executable bit from upstream
    if [ -x "$upstream_dir/$rel" ] 2>/dev/null; then chmod +x "$dest"; fi
    echo "Applied:  $rel"
    applied=$((applied + 1))
  fi
done

# Handle deleted-upstream files: report but don't auto-delete
for rel in $(printf '%s\n' "${!status[@]}" | sort); do
  if [ "${status[$rel]}" = "deleted-upstream" ]; then
    echo "DELETED UPSTREAM: $rel (kept locally — remove manually if desired)"
  fi
done

# Update the base commit
echo "$upstream_sha" > "$base_state_file"
echo ""
echo "Applied $applied file(s), $conflicted conflict(s)."
echo "Base updated to ${upstream_sha:0:12}."
if [ $conflicted -gt 0 ]; then
  echo "Resolve conflicts, then commit."
fi
